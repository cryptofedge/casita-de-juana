# --- Database (PostgreSQL) ---------------------------------------------------
# Local default matches docker-compose.yml and `npm run db:local`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casita?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app (used for invite links)
APP_URL="http://localhost:3000"   # on Vercel you can omit it: the production domain is detected

# --- File uploads ------------------------------------------------------------
# Receipts, meter photos, ticket photos and documents are stored IN the database and only served
# through /api/files/[id] after an authorization check. Photos are shrunk in the browser first.
# Keep this at or below 4 on Vercel (request bodies are limited to ~4.5 MB).
MAX_UPLOAD_MB="4"

# --- Scheduled billing (optional) ---------------------------------------------
# Call GET /api/cron/billing with header "Authorization: Bearer <CRON_SECRET>"
# once a day to generate monthly rent and late fees even if nobody logs in.
CRON_SECRET="replace-me-with-another-random-string"

# --- Seed data ----------------------------------------------------------------
# Passwords for the demo accounts created by `npm run db:seed`.
# CHANGE THESE (or delete the demo users) before going live.
SEED_OWNER_PASSWORD="Owner#2026"
SEED_TENANT_PASSWORD="Tenant#2026"

# --- First owner login on deploy (optional) -----------------------------------
# scripts/bootstrap-owner.mjs creates this owner on the first deploy if the email does not exist.
# Remove the password variable afterwards.
# BOOTSTRAP_OWNER_EMAIL="you@example.com"
# BOOTSTRAP_OWNER_NAME="Juana Rodríguez"
# BOOTSTRAP_OWNER_PASSWORD="at-least-10-characters"
