# --- Database (PostgreSQL) ---------------------------------------------------
# Local default matches docker-compose.yml and `npm run db:local`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casita?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app (used for invite links)
APP_URL="http://localhost:3000"

# --- File uploads ------------------------------------------------------------
# Receipts, meter photos, ticket photos and the document vault are stored here.
# Files are only served through /api/files/[id] after an authorization check.
# On serverless hosts (Vercel) swap lib/storage.ts for S3/R2/Supabase Storage.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"

# --- Scheduled billing (optional) ---------------------------------------------
# Call GET /api/cron/billing with header "Authorization: Bearer <CRON_SECRET>"
# once a day to generate monthly rent and late fees even if nobody logs in.
CRON_SECRET="replace-me-with-another-random-string"

# --- Seed data ----------------------------------------------------------------
# Passwords for the demo accounts created by `npm run db:seed`.
# CHANGE THESE (or delete the demo users) before going live.
SEED_OWNER_PASSWORD="Owner#2026"
SEED_TENANT_PASSWORD="Tenant#2026"
